@inherits LayoutComponentBase

<div class="app-shell">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="app-header">
        <a class="brand" href="/" aria-label="YtDownloader home">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 4v11m-4-4 4 4 4-4M5 16v4h14v-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
            <span>Yt<span class="brand-accent">Downloader</span><small>PERSONAL MEDIA STUDIO</small></span>
        </a>
        <nav class="header-nav" aria-label="Main navigation">
            <a href="/#converter">Converter</a>
            <a href="/#history">History</a>
        </nav>
        <span class="header-note">MP4 <span aria-hidden="true">/</span> MP3</span>
    </header>
    <main id="main-content" class="app-main">@Body</main>
    <footer class="app-footer">
        <span>Made for your personal media collection.</span>
        <span>Convert. Save. Enjoy.</span>
    </footer>
</div>
<div id="blazor-error-ui" data-nosnippet role="alert">
    Something went wrong. Reload the page to reconnect.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss error">×</button>
</div>
